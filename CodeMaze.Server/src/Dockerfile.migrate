ARG DOTNET_VERSION=10.0
FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION} AS build
WORKDIR /src
COPY . .
RUN dotnet tool restore
RUN dotnet restore CodeMaze.Server/src/CodeMaze.Server.csproj -r linux-x64
RUN dotnet ef migrations bundle \
    --project CodeMaze.Server/src/CodeMaze.Server.csproj \
    --self-contained -r linux-x64 \
    -o /out/efbundle --force

FROM mcr.microsoft.com/dotnet/runtime-deps:${DOTNET_VERSION}
COPY --from=build /out/efbundle /efbundle
ENTRYPOINT ["/efbundle"]